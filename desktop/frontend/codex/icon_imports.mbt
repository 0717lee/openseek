// Codex renders with the same icon package as the OpenSeek shell without
// importing the shell package or duplicating SVG markup.

///|
using @icons {
  icon,
  icon_add,
  icon_archive,
  icon_arrow_up,
  icon_debug_stop,
  icon_folder,
  icon_layout_sidebar_left,
  icon_layout_sidebar_right,
  icon_sparkle,
  icon_terminal,
}
