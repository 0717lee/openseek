///|
/// Generate a fresh conversation session id and feed it back through
/// `SessionRotated`. Issued at startup and again by "New chat", so the model
/// never reads the clock directly.
fn rotate_session(
  dispatch : @cmd.Emit[Msg],
  channel : @interop.ChannelId,
) -> @cmd.Cmd {
  @cmd.custom_cmd(scheduler => {
    scheduler.add(
      dispatch(SessionRotated({ channel, session: generated_session_id() })),
    )
  })
}

///|
/// A Codex add action carries the chosen project through the same effectful id
/// rotation as OpenSeek, without constructing an app-server thread. Keeping
/// this operation on a small type makes the external clock/random read explicit
/// and keeps `update` deterministic.
priv struct CodexDraftRotation {
  cwd : String
}

///|
fn CodexDraftRotation::rotate(
  self : CodexDraftRotation,
  dispatch : @cmd.Emit[Msg],
) -> @cmd.Cmd {
  @cmd.custom_cmd(scheduler => {
    scheduler.add(
      dispatch(CodexDraftRotated(cwd=self.cwd, id=generated_session_id())),
    )
  })
}

///|
/// Start a new chat with the Codex agent — the route every "New chat" entry
/// point takes while Codex is the default agent. When Codex cannot start a
/// thread (app-server down or signed out), open the Codex page instead:
/// sign-in and connection state live there.
fn new_codex_chat(
  dispatch : @cmd.Emit[Msg],
  model : Model,
  workspace : @common.Uri?,
) -> (@cmd.Cmd, Model) {
  guard model.codex.can_start_thread() else {
    return update_msg(dispatch, OpenCodex, model)
  }
  let cwd = workspace
    .bind(project => @resource.path_for(project, model.focused))
    .unwrap_or(model.codex.new_thread_cwd())
  (
    CodexDraftRotation::{ cwd, }.rotate(dispatch),
    {
      ..model,
      screen: Codex,
      sidebar_open: model.sidebar_open && !model.narrow,
    },
  )
}

///|
/// Start a local DeepSeek Harness conversation. A caller with a concrete
/// OpenSeek/Codex project passes its resource path so the handoff stays in the
/// same directory; the dsh section's generic add action passes `None` and
/// keeps dsh's currently selected Workspace. If dsh is not ready, opening its
/// page and refreshing is the only honest action — no session or model exists
/// yet to select.
fn Model::new_dsh_chat(
  self : Model,
  dispatch : @cmd.Emit[Msg],
  workspace_path : String?,
) -> (@cmd.Cmd, Model) {
  let (dsh_cmd, dsh) = if self.dsh.can_create() {
    let path = if workspace_path is Some(path) {
      Some(path)
    } else if self.dsh.preferred_workspace_id() is None {
      self
      .device_state(@interop.ChannelId::Local)
      .bind(dev => dev.active_project)
      .bind(project => @resource.path_for(project, @interop.ChannelId::Local))
    } else {
      None
    }
    let dsh_msg = if path is Some(path) {
      @dsh.Msg::new_workspace_session(path)
    } else {
      @dsh.Msg::new_session(self.dsh.preferred_workspace_id())
    }
    @dsh.update(dispatch.map(msg => Dsh(msg)), dsh_msg, self.dsh)
  } else {
    @dsh.update(dispatch.map(msg => Dsh(msg)), @dsh.Msg::refresh(), self.dsh)
  }
  (
    @cmd.batch([dsh_cmd, save_default_agent(DshAgent)]),
    {
      ..self,
      screen: Dsh,
      sidebar_open: self.sidebar_open && !self.narrow,
      default_agent: DshAgent,
      loading_conversation: None,
      dsh,
    },
  )
}

///|
/// Session ids generated by the desktop client: a UTC wall-clock stamp,
/// `desktop-YYYYMMDD-HHMMSS-mmm-sssssssss`, mirroring the TUI's `tui-...` form
/// with a random salt so two windows rotating in the same millisecond still get
/// separate conversations.
fn generated_session_id() -> String {
  let date_constructor : @js.Value = @js.globalThis.get_with_string("Date")
  let now : @js.Value = date_constructor.new(([] : Array[@js.Value]))
  fn utc(name : String) -> Int {
    now.apply_with_string(name, ([] : Array[@js.Value]))
  }

  let date = pad(utc("getUTCFullYear"), 4) +
    pad(utc("getUTCMonth") + 1, 2) +
    pad(utc("getUTCDate"), 2)
  let time = pad(utc("getUTCHours"), 2) +
    pad(utc("getUTCMinutes"), 2) +
    pad(utc("getUTCSeconds"), 2)
  "desktop-\{date}-\{time}-\{pad(utc("getUTCMilliseconds"), 3)}-\{random_salt()}"
}

///|
fn random_salt() -> String {
  let math : @js.Value = @js.globalThis.get_with_string("Math")
  let value : Double = math.apply_with_string("random", ([] : Array[@js.Value]))
  pad((value * 1_000_000_000.0).to_int(), 9)
}

///|
fn pad(value : Int, width : Int) -> String {
  let mut text = value.to_string()
  while text.length() < width {
    text = "0\{text}"
  }
  text
}
