import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
}

///|
struct BrowserBundle {
  name : String
  title : String
}

///|
fn smoke_bundles() -> Array[BrowserBundle] {
  [
    BrowserBundle::{
      name: "component",
      title: "MoonBit Viewer Component Test",
    },
    BrowserBundle::{
      name: "read_api",
      title: "MoonBit Viewer Read API Test",
    },
    BrowserBundle::{
      name: "whitespace_selection",
      title: "MoonBit Viewer Whitespace Selection Test",
    },
    BrowserBundle::{
      name: "agent_feedback",
      title: "MoonBit Viewer Agent Feedback Test",
    },
    BrowserBundle::{
      name: "model_swap",
      title: "MoonBit Viewer Model Swap Test",
    },
    BrowserBundle::{
      name: "folding",
      title: "MoonBit Viewer Folding Test",
    },
    BrowserBundle::{
      name: "folding_nested",
      title: "MoonBit Viewer Nested Folding Test",
    },
    BrowserBundle::{
      name: "quick_diff",
      title: "MoonBit Viewer Quick Diff Test",
    },
    BrowserBundle::{
      name: "definition",
      title: "MoonBit Viewer Definition Navigation Test",
    },
    BrowserBundle::{
      name: "peek_references",
      title: "MoonBit Viewer Peek References Test",
    },
  ]
}

///|
async fn browser_bundle_exists(
  build_dir : String,
  bundle : BrowserBundle,
) -> Bool {
  @fs.exists(build_dir + "/" + bundle.name + "/" + bundle.name + ".js") &&
  @fs.exists(build_dir + "/" + bundle.name + "/" + bundle.name + ".js.map")
}

///|
/// Selects only a complete, unambiguous output layout from the workspace build.
/// If both layouts contain every requested bundle, one may be stale, so refuse
/// to stage either instead of silently serving the wrong checkout.
async fn resolved_browser_build_dir(
  bundles : Array[BrowserBundle],
) -> String {
  let plain = "_build/js/debug/build/tests/browser/moonbit"
  let module_dir = "_build/js/debug/build/moonbitlang/editor/tests/browser/moonbit"
  let mut plain_complete = true
  let mut module_complete = true
  for bundle in bundles {
    if !browser_bundle_exists(plain, bundle) {
      plain_complete = false
    }
    if !browser_bundle_exists(module_dir, bundle) {
      module_complete = false
    }
  }
  match (plain_complete, module_complete) {
    (true, false) => plain
    (false, true) => module_dir
    (false, false) =>
      fail("missing js artifacts for the browser test bundles; run `moon build` first")
    (true, true) =>
      fail(
        "ambiguous browser bundle layouts; remove stale _build js artifacts and rebuild",
      )
  }
}

///|
async fn write_browser_bundle(
  bundle : BrowserBundle,
  build_dir : String,
  browser_tests_dir : String,
) -> Unit {
  let source_dir = build_dir + "/" + bundle.name
  let generated_js = @fs.read_file(
    source_dir + "/" + bundle.name + ".js",
  ).text()
  @fs.write_file(
    browser_tests_dir + "/" + bundle.name + ".mjs",
    generated_js.replace(
      old="//# sourceMappingURL=" + bundle.name + ".js.map",
      new="//# sourceMappingURL=" + bundle.name + ".mjs.map",
    ),
    create_mode=@fs.CreateOrTruncate,
  )
  @fs.write_file(
    browser_tests_dir + "/" + bundle.name + ".mjs.map",
    @fs.read_file(source_dir + "/" + bundle.name + ".js.map"),
    create_mode=@fs.CreateOrTruncate,
  )
  @fs.write_file(
    browser_tests_dir + "/" + bundle.name + ".html",
    browser_test_html(
      bundle.title,
      "/browser-tests/" + bundle.name + ".mjs",
    ),
    create_mode=@fs.CreateOrTruncate,
  )
}

///|
async fn main {
  let bundles = smoke_bundles()
  let build_dir = resolved_browser_build_dir(bundles)
  let browser_tests_dir = "web/dist/browser-tests"
  if !@fs.exists(browser_tests_dir) {
    @fs.mkdir(browser_tests_dir, recursive=true)
  }
  for bundle in bundles {
    write_browser_bundle(bundle, build_dir, browser_tests_dir)
  }
  println("Generated browser test bundles under web/dist/browser-tests")
}

///|
fn browser_test_html(title : String, script_src : String) -> String {
  (
    $|<!doctype html>
    $|<html lang="en">
    $|  <head>
    $|    <meta charset="UTF-8" />
    $|    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    $|    <base href="/">
    $|    <title>\{title}</title>
    $|    <link rel="stylesheet" href="/style.css">
    $|  </head>
    $|  <body>
    $|    <div id="app"></div>
    $|    <script type="module" src="\{script_src}"></script>
    $|  </body>
    $|</html>
  )
}
