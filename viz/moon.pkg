import {
  "bobzhang/openseek/agent_session",
  "bobzhang/openseek/agent_session/log" @session_log,
  "bobzhang/openseek/agent_tool/plan/steps",
  "bobzhang/openseek/deepseek",
  "moonbit-community/rabbita/html",
  "moonbitlang/core/immut/vector",
  "moonbitlang/core/json",
}

import {
  "bobzhang/openseek/viz/testkit",
} for "test"

warnings = "+unnecessary_annotation"

// The viewer ships to the browser; native is here so `viz/render_test` can
// render these views to strings through rabbita's server-side renderer.

supported_targets = "js+native"
